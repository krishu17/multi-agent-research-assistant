# Copy to .env and fill in the provider you want to use.
# LLM_PROVIDER controls the LangGraph path (src/graph.py):
#   mock      -> deterministic offline stand-in, no key needed (default)
#   openai    -> requires OPENAI_API_KEY
#   anthropic -> requires ANTHROPIC_API_KEY
#   ollama    -> requires a local Ollama server, no key needed
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OLLAMA_MODEL=llama3.1

# CrewAI path (src/crew.py) always needs a real model -- it does not use
# LLM_PROVIDER / the mock backend. Format: "<provider>/<model>" per litellm.
CREWAI_MODEL=openai/gpt-4.1
